# ==============================
#  Cấu hình ứng dụng Habit Tracker
#  Sao chép file này thành .env rồi sửa giá trị
# ==============================

# Cổng ứng dụng chạy (aaPanel Node project sẽ trỏ vào cổng này)
PORT=3000

# Chuỗi bí mật để ký phiên đăng nhập — BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai

# Đặt true khi web chạy qua HTTPS (khuyến nghị khi đã bật SSL trên aaPanel)
COOKIE_SECURE=false

# Cho phép đăng ký tài khoản mới. Sau khi tạo xong tài khoản của mình,
# đặt false để không ai khác đăng ký được.
ALLOW_REGISTER=true

# ------------------------------
#  CƠ SỞ DỮ LIỆU
#  DB_CLIENT=sqlite  -> dùng file SQLite (không cần cấu hình gì thêm)
#  DB_CLIENT=mysql   -> dùng database MySQL tạo trên aaPanel
# ------------------------------
DB_CLIENT=sqlite

# SQLite: đường dẫn file database (tương đối với thư mục dự án)
SQLITE_FILE=./data/habit.sqlite

# MySQL (lấy từ aaPanel > Databases)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=habit_tracker
DB_USER=habit_tracker
DB_PASSWORD=
