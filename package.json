{
  "name": "habit-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Ứng dụng theo dõi thói quen cá nhân — Vue 3 + Express + SQLite/MySQL",
  "main": "server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "cd client && npm install && npm run build",
    "init-db": "node server/init-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.14.0",
    "svg-captcha": "^1.4.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.0.0"
  }
}
